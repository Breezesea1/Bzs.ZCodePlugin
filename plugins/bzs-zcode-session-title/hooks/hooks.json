{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hook.mjs\" --init --config \"${ZCODE_PLUGIN_DATA}/config.json\"",
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/hook.mjs\" --config \"${ZCODE_PLUGIN_DATA}/config.json\"",
            "async": true,
            "timeoutMs": 60000
          }
        ]
      }
    ]
  }
}
